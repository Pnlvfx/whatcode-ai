{
  "name": "@whatcode-ai/sdk",
  "version": "2.8.0-canary.0",
  "description": "Core SDK to start opencode and optionally expose it over HTTPS",
  "keywords": [
    "opencode",
    "tailscale",
    "ai",
    "cli",
    "sdk",
    "server",
    "https",
    "tunnel",
    "remote",
    "whatcode"
  ],
  "homepage": "https://www.whatcode.app/",
  "bugs": {
    "url": "https://github.com/Pnlvfx/whatcode-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Pnlvfx/whatcode-ai.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "author": {
    "name": "Simone Gauli",
    "email": "simonegauli@gmail.com"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/whatcode.ts",
    "./internals": "./src/cli/utilities.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && eslint",
    "initialize": "node tools/initialize.ts",
    "lint": "eslint",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/standard-validator": "^0.4.1",
    "@opencode/client": "^2.2.7",
    "@opentunnel/client": "^0.6.2",
    "execa": "^10.2.1",
    "exit-hook": "^5.1.0",
    "hono": "^4.13.17",
    "node-machine-id": "^1.1.12",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@eslint/config-helpers": "^0.7.0",
    "@goatjs/node-monorepo-eslint": "^3.51.0",
    "@goatjs/rimraf": "^2.15.0",
    "@goatjs/typescript-config": "^2.3.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/whatcode.d.ts",
        "import": "./dist/whatcode.js"
      },
      "./internals": {
        "types": "./dist/cli/utilities.d.ts",
        "import": "./dist/cli/utilities.js"
      }
    }
  }
}
